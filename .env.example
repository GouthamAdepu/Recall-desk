# ── Hindsight Cloud (https://hindsight.vectorize.io/) ──
HINDSIGHT_API_KEY=your_hindsight_api_key
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_TIMEOUT=30
HINDSIGHT_RECALL_BUDGET=mid     # low | mid | high
HINDSIGHT_REFLECT_BUDGET=low    # low | mid | high

# ── LLM: Groq (OpenAI-compatible) running openai/gpt-oss-120b ──
# Get a key at https://console.groq.com/keys
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=openai/gpt-oss-120b
# Triage + fact extraction model (gpt-oss-20b is faster; or reuse 120b)
LLM_FAST_MODEL=openai/gpt-oss-20b
# gpt-oss is a reasoning model: low | medium | high (low = fastest, best for live chat)
LLM_REASONING_EFFORT=low
LLM_JSON_MODE=true

# Alternative: Anthropic
# LLM_PROVIDER=anthropic
# LLM_API_KEY=your-anthropic-key
# LLM_MODEL=claude-sonnet-5
# LLM_REASONING_EFFORT=

# ── Behaviour ──
ESCALATION_THRESHOLD=3
CORS_ORIGINS=http://localhost:5173
